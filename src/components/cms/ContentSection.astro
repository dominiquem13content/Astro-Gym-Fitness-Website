---
import RichTextSection from './sections/RichTextSection.astro';
import FAQAccordionSection from './sections/FAQAccordionSection.astro';
import ComparisonTableSection from './sections/ComparisonTableSection.astro';
import CalloutBoxSection from './sections/CalloutBoxSection.astro';
import ChecklistSection from './sections/ChecklistSection.astro';
import NumberedStepsSection from './sections/NumberedStepsSection.astro';
import FeatureHighlightsSection from './sections/FeatureHighlightsSection.astro';
import TwoColumnTextSection from './sections/TwoColumnTextSection.astro';
import CTABannerSection from './sections/CTABannerSection.astro';

interface Props {
  section: {
    id: string;
    section_type: string;
    title: string | null;
    content: string | null;
    content_data: Record<string, any>;
    is_active: boolean;
  };
}

const { section } = Astro.props;
if (!section.is_active) return;

const { section_type, title, content, content_data } = section;
---

<div class="cms-section" data-section-id={section.id} data-section-type={section_type}>
  {section_type === 'rich_text' && (
    <RichTextSection title={title} content={content} />
  )}

  {section_type === 'faq_accordion' && (
    <FAQAccordionSection
      title={title}
      faqs={content_data.faqs || []}
    />
  )}

  {section_type === 'comparison_table' && (
    <ComparisonTableSection
      title={title}
      headers={content_data.headers || []}
      rows={content_data.rows || []}
    />
  )}

  {section_type === 'callout_box' && (
    <CalloutBoxSection
      title={title}
      content={content}
      variant={content_data.variant || content_data.callout_type || 'info'}
    />
  )}

  {section_type === 'checklist' && (
    <ChecklistSection
      title={title}
      items={content_data.items || []}
    />
  )}

  {section_type === 'numbered_steps' && (
    <NumberedStepsSection
      title={title}
      steps={content_data.steps || []}
    />
  )}

  {section_type === 'feature_highlights' && (
    <FeatureHighlightsSection
      title={title}
      features={content_data.features || []}
    />
  )}

  {section_type === 'two_column_text' && (
    <TwoColumnTextSection
      title={title}
      leftColumn={content_data.left_column || ''}
      rightColumn={content_data.right_column || ''}
    />
  )}

  {section_type === 'cta_banner' && (
    <CTABannerSection
      title={title}
      content={content}
      primaryButtonText={content_data.primary_button_text}
      primaryButtonUrl={content_data.primary_button_url}
      secondaryButtonText={content_data.secondary_button_text}
      secondaryButtonUrl={content_data.secondary_button_url}
    />
  )}
</div>
