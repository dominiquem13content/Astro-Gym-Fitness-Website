---
interface Step {
  title: string;
  content: string;
}

interface Props {
  title?: string | null;
  steps: Step[];
}

const { title, steps = [] } = Astro.props;
---

{steps.length > 0 && (
  <section class="cms-numbered-steps">
    {title && <h2 class="text-2xl md:text-3xl font-bold text-white mb-8 font-heading">{title}</h2>}
    <div class="space-y-6">
      {steps.map((step, index) => (
        <div class="flex gap-5">
          <div class="shrink-0 w-10 h-10 rounded-full bg-orange-500 flex items-center justify-center text-white font-bold text-lg">
            {index + 1}
          </div>
          <div class="flex-1 pt-1">
            <h3 class="text-lg font-semibold text-white mb-2">{step.title}</h3>
            <p class="text-slate-300 leading-relaxed">{step.content}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
)}
