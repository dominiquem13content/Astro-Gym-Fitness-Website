---
interface Props {
  title?: string | null;
  content?: string | null;
}

const { title, content } = Astro.props;
---

{content && (
  <section class="cms-rich-text">
    {title && <h2 class="text-2xl md:text-3xl font-bold text-white mb-6 font-heading">{title}</h2>}
    <div class="prose prose-invert max-w-none text-slate-300 leading-relaxed space-y-4" set:html={content} />
  </section>
)}
