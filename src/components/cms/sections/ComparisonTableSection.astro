---
interface Row {
  label: string;
  values: string[];
}

interface Props {
  title?: string | null;
  headers: string[];
  rows: Row[];
}

const { title, headers = [], rows = [] } = Astro.props;
---

{rows.length > 0 && (
  <section class="cms-comparison-table">
    {title && <h2 class="text-2xl md:text-3xl font-bold text-white mb-8 font-heading">{title}</h2>}
    <div class="overflow-x-auto rounded-xl border border-slate-700">
      <table class="w-full text-left">
        <thead>
          <tr class="bg-slate-800">
            {headers.map((header, i) => (
              <th class={`px-6 py-4 text-sm font-semibold uppercase tracking-wider ${i === 0 ? 'text-slate-300' : 'text-orange-400'}`}>
                {header}
              </th>
            ))}
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-700/50">
          {rows.map((row, rowIndex) => (
            <tr class={`${rowIndex % 2 === 0 ? 'bg-slate-800/30' : 'bg-slate-800/10'} hover:bg-slate-700/30 transition-colors`}>
              <td class="px-6 py-4 font-medium text-white">{row.label}</td>
              {row.values.map(value => (
                <td class="px-6 py-4 text-slate-300">{value}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
)}
