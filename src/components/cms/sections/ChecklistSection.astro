---
interface Props {
  title?: string | null;
  items: string[];
}

const { title, items = [] } = Astro.props;
---

{items.length > 0 && (
  <section class="cms-checklist">
    {title && <h2 class="text-2xl md:text-3xl font-bold text-white mb-6 font-heading">{title}</h2>}
    <div class="grid sm:grid-cols-2 gap-3">
      {items.map(item => (
        <div class="flex items-start gap-3 p-3 rounded-lg bg-slate-800/40 border border-slate-700/50">
          <i class="ri-check-line text-emerald-400 text-xl mt-0.5 shrink-0"></i>
          <span class="text-slate-300">{item}</span>
        </div>
      ))}
    </div>
  </section>
)}
