---
interface Props {
  title?: string | null;
  content?: string | null;
  primaryButtonText?: string;
  primaryButtonUrl?: string;
  secondaryButtonText?: string;
  secondaryButtonUrl?: string;
}

const {
  title,
  content,
  primaryButtonText,
  primaryButtonUrl,
  secondaryButtonText,
  secondaryButtonUrl,
} = Astro.props;
---

<section class="cms-cta-banner rounded-2xl bg-gradient-to-r from-orange-500 to-orange-600 p-8 md:p-12 text-center">
  {title && <h2 class="text-2xl md:text-3xl font-bold text-white mb-4 font-heading">{title}</h2>}
  {content && <p class="text-white/90 text-lg mb-8 max-w-2xl mx-auto">{content}</p>}
  <div class="flex flex-wrap items-center justify-center gap-4">
    {primaryButtonText && primaryButtonUrl && (
      <a
        href={primaryButtonUrl}
        class="inline-flex items-center gap-2 bg-white text-orange-600 hover:bg-slate-100 px-8 py-3.5 rounded-lg font-bold text-lg transition-all transform hover:scale-105 shadow-lg"
      >
        {primaryButtonText}
        <i class="ri-arrow-right-line"></i>
      </a>
    )}
    {secondaryButtonText && secondaryButtonUrl && (
      <a
        href={secondaryButtonUrl}
        class="inline-flex items-center gap-2 border-2 border-white/80 text-white hover:bg-white/10 px-8 py-3.5 rounded-lg font-bold text-lg transition-all"
      >
        {secondaryButtonText}
      </a>
    )}
  </div>
</section>
