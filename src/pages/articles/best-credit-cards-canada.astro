---
import CMSLayout from '../../layouts/CMSLayout.astro';
import ContentSection from '../../components/cms/ContentSection.astro';
import SeoBlock from '../../components/cms/SeoBlock.astro';
import { getPageSections, getSeoContent } from '../../lib/cms';

const PAGE_TYPE = 'article';
const PAGE_ID = '00000000-0000-0000-0000-000000000001';

const [contentSections, seoContent] = await Promise.all([
  getPageSections(PAGE_TYPE, PAGE_ID),
  getSeoContent(PAGE_TYPE, PAGE_ID),
]);

const pageTitle = 'Best Credit Cards in Canada 2026 - Complete Guide';
const pageDescription = 'Compare the best Canadian credit cards for rewards, cash back, travel, and more. Expert picks to help you choose the right card.';
---

<CMSLayout title={pageTitle} description={pageDescription}>
  <article>
    <header class="bg-gradient-to-b from-slate-800 to-slate-900 py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-2 text-orange-400 text-sm font-medium mb-4">
          <i class="ri-article-line"></i>
          <span>Credit Cards Guide</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-bold text-white font-heading leading-tight mb-6">
          Best Credit Cards in Canada 2026
        </h1>
        <p class="text-lg md:text-xl text-slate-300 leading-relaxed max-w-3xl">
          {pageDescription}
        </p>
        <div class="flex items-center gap-6 mt-8 text-sm text-slate-400">
          <span class="flex items-center gap-2">
            <i class="ri-calendar-line"></i>
            Updated February 2026
          </span>
          <span class="flex items-center gap-2">
            <i class="ri-time-line"></i>
            12 min read
          </span>
        </div>
      </div>
    </header>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
      <SeoBlock content={seoContent?.intro_text} class="mb-12 text-lg border-l-4 border-orange-500 pl-6" />

      <SeoBlock content={seoContent?.main_content} class="mb-12" />

      <div class="space-y-12">
        {contentSections.map(section => (
          <ContentSection section={section} />
        ))}
      </div>

      <SeoBlock content={seoContent?.bottom_content} class="mt-12 pt-12 border-t border-slate-700" />
    </div>
  </article>
</CMSLayout>
