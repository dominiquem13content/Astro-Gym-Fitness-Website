---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import TemplateForm from '../../../components/admin/TemplateForm.astro';
import { createServerClient } from '../../../lib/supabase-server';
import { createTemplate } from '../../../lib/cms-admin';

export const prerender = false;

let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const supabase = createServerClient(Astro.cookies);

  let sections: Record<string, any>[] = [];
  try {
    const raw = form.get('sections')?.toString().trim();
    if (raw) sections = JSON.parse(raw);
  } catch {
    error = 'Invalid JSON in Sections field.';
  }

  if (!error) {
    try {
      await createTemplate(supabase, {
        template_name: form.get('template_name')?.toString() ?? '',
        page_type: form.get('page_type')?.toString() ?? 'article',
        description: form.get('description')?.toString() || null,
        is_public: form.get('is_public') === 'true',
        sections,
      });
      return Astro.redirect('/admin/templates?success=Template+created+successfully');
    } catch (e: any) {
      error = e.message || 'Failed to create template.';
    }
  }
}
---

<AdminLayout title="New Template">
  <div class="max-w-3xl">
    <div class="mb-6">
      <a href="/admin/templates" class="text-sm text-slate-400 hover:text-slate-300 transition-colors flex items-center gap-1">
        <i class="ri-arrow-left-s-line"></i> Back to templates
      </a>
    </div>
    <TemplateForm error={error} />
  </div>
</AdminLayout>
